# ===========================================================================
# Modelo de .env de UM ambiente.
#
# Copie para `.env` ao lado do docker-compose.yml e preencha. O arquivo nao vai
# para o git (ver .gitignore) — e o unico lugar onde segredo mora.
#
# Ha tres perfis prontos aqui embaixo: maquina local, dev do servidor e
# producao. Use um deles como ponto de partida; o que muda entre os tres esta
# marcado.
#
# Depois de preencher, no servidor:   chmod 600 .env
# ===========================================================================


# --- IDENTIDADE DO AMBIENTE ------------------------------------------------

# Nomeia o projeto no Compose. E o que impede os dois stacks de colidirem no
# mesmo servidor, e o que forma o alias que o Caddy procura (`${STACK}-web`).
#   local:  quiron-local        dev: quiron-dev        producao: quiron-prod
STACK=quiron-prod

# Quais arquivos de compose entram. `:` e o separador; o COMPOSE_PATH_SEPARATOR
# abaixo o fixa, senao no Windows o padrao seria `;`.
#
#   local:     docker-compose.yml:docker-compose.build.yml:docker-compose.dev.yml
#   dev:       docker-compose.yml:docker-compose.dev.yml
#   producao:  docker-compose.yml
COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:

# `production` liga as exigencias mais rigidas do backend (ex.: SECRET_KEY
# passa a ser obrigatoria). Use `development` so na maquina local.
NODE_ENV=production


# --- IMAGENS ---------------------------------------------------------------

# No servidor: as imagens construidas e testadas pela CI, vindas do GHCR.
# A tag e o SHA do commit — nunca `latest`, para o rollback ser possivel e o
# `up -d` nao trocar a versao sem alguem pedir.
#   IMAGEM_BACKEND=ghcr.io/fronteiratec/quiron-backend:a1b2c3d
#   IMAGEM_FRONTEND=ghcr.io/fronteiratec/quiron-frontend:a1b2c3d
#
# Na maquina local, com o override de build, estes dois viram so o nome local:
IMAGEM_BACKEND=quiron-backend:local
IMAGEM_FRONTEND=quiron-frontend:local


# --- BANCO -----------------------------------------------------------------

# Um banco POR AMBIENTE. Mesmo em servidores separados, use senhas diferentes:
# a senha de dev circula mais (fica em log, em print, em mensagem de equipe).
DB_USER=quiron
DB_NAME=quiron
# Gere:  openssl rand -base64 24
DB_PASSWORD=

# Lida SO na primeira subida contra um banco sem registro de migracao.
#   baseline  banco novo, criado pelo schema.sql -> carimba sem executar
#   aplicar   banco antigo, atrasado             -> executa as migracoes
# Ver backend/scripts/migrar.js.
MIGRACAO_PRIMEIRA_VEZ=baseline


# --- SEGREDOS DA APLICACAO -------------------------------------------------

# DIFERENTES entre dev e producao, sempre. Um segredo de dev vazado nao pode
# assinar um token que producao aceite.
#
# Gere:  openssl rand -base64 48
JWT_SECRET=

# Cifra os refresh tokens do Google no banco (AES-256-GCM). Separada do
# JWT_SECRET de proposito: trocar o JWT_SECRET derruba as sessoes e se faz sem
# drama; trocar ESTA torna ilegivel todo refresh token ja gravado e obriga
# todo mundo a reconectar a agenda.
#
# Gere:  openssl rand -base64 32
SECRET_KEY=

JWT_EXPIRES=8h


# --- ENDERECO PUBLICO ------------------------------------------------------

# Base dos links dentro dos e-mails e origem aceita no CORS. Precisa ser o
# endereco que o DESTINATARIO abre — com https, no servidor.
#   local:  http://localhost
#   dev:    https://dev.seudominio.com
#   prod:   https://app.seudominio.com
FRONTEND_URL=https://app.seudominio.com


# --- E-MAIL ----------------------------------------------------------------

# Com SMTP_HOST vazio o sistema cai numa conta de teste Ethereal e nada e
# enviado de verdade: e o modo de desenvolvimento. Em producao, preencha.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=


# --- GOOGLE AGENDA (opcional) ----------------------------------------------

# Sem CLIENT_ID/SECRET a integracao fica invisivel: o cartao nao aparece no
# Perfil e nada e enviado. Ver docs/google-agenda.md.
#
# Use um par de credenciais POR AMBIENTE. O redirect precisa bater exato com o
# cadastrado no Google Cloud, e um so nao serve para dois dominios.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.seudominio.com/api/google-agenda/callback
GOOGLE_SCOPE_CALENDAR=
TZ_AGENDA=America/Sao_Paulo
